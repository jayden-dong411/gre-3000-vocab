{
  "name": "gre-3000",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43173",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 43173",
    "desktop": "electron electron/main.cjs",
    "pack:linux": "electron-builder --linux dir",
    "pack:mac": "electron-builder --mac zip --arm64"
  },
  "build": {
    "appId": "com.gre3000.vocab",
    "productName": "GRE 3000",
    "asar": true,
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["dir"],
      "category": "Education",
      "executableName": "gre-3000"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "zip",
          "arch": ["arm64"]
        }
      ],
      "identity": null
    }
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vite-plugin-pwa": "^1.3.0"
  },
  "optionalDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
